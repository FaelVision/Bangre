DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-in-production-please-use-a-long-random-string"

# Set to "true" only when Bangre is served over HTTPS. Left unset, session
# cookies work over plain HTTP on the school's local network (http://192.168.x.x);
# "true" over HTTP would drop every cookie and lock everyone out.
COOKIE_SECURE=""

# WhatsApp Cloud API (Meta). Leave unset to run in mock/dev mode — reminders
# and payment notifications are logged and recorded, not actually sent.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Token you choose, echoed back to Meta when you register the webhook URL
# (https://<host>/api/whatsapp/webhook) so delivery/read receipts update reminders.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Shared secret for the automatic-reminder cron endpoint. Call it once an hour:
#   curl -X POST https://<host>/api/cron/reminders -H "Authorization: Bearer $CRON_SECRET"
# Leave unset and the endpoint refuses every call (503) — automatic reminders
# are simply off until it is set.
CRON_SECRET=""

# Mobile Money providers. Leave unset to run in mock/dev mode (subscription
# payments auto-succeed as if the USSD prompt had been approved).
ORANGE_MONEY_API_KEY=""
ORANGE_MONEY_MERCHANT_ID=""
MOOV_MONEY_API_KEY=""
MOOV_MONEY_MERCHANT_ID=""

# Sign in with Google (OAuth 2.0). Unlike the integrations above there is no
# simulation mode: without these the Google button stays disabled, because
# faking a verified identity would let anyone sign in as anyone.
# Create the credentials at https://console.cloud.google.com/apis/credentials
# and register the redirect URI(s) you use, e.g.
#   http://localhost:3000/api/auth/google/callback
#   http://192.168.1.10:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: force a single redirect URI instead of deriving it from the request.
GOOGLE_REDIRECT_URI=""
