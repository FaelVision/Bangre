DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-in-production-please-use-a-long-random-string"

# Set to "true" only when Bangré is served over HTTPS. Left unset, session
# cookies work over plain HTTP on the school's local network (http://192.168.x.x);
# "true" over HTTP would drop every cookie and lock everyone out.
COOKIE_SECURE=""

# No WhatsApp API credentials needed: reminders and payment confirmations are
# wa.me deep links the user opens and sends themselves (see src/lib/whatsapp.ts).

# Brevo (email), single-sender verification — no domain needed. Leave
# unset to run in mock/dev mode — password-reset emails (and any account with
# only an email on file) are logged, not actually sent.
# 1. Create a free account at https://www.brevo.com
# 2. Verify one sender address at https://app.brevo.com/senders/list
# 3. Create an API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""

# No Mobile Money API credentials needed: a school transfers the subscription
# fee to Bangré's own Orange/Moov Money number (see subscription-form.tsx) and
# an admin confirms the payment by hand from /admin once it's received.

# Sign in with Google (OAuth 2.0). Unlike the integrations above there is no
# simulation mode: without these the Google button stays disabled, because
# faking a verified identity would let anyone sign in as anyone.
# Create the credentials at https://console.cloud.google.com/apis/credentials
# and register the redirect URI(s) you use, e.g.
#   http://localhost:3000/api/auth/google/callback
#   http://192.168.1.10:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: force a single redirect URI instead of deriving it from the request.
GOOGLE_REDIRECT_URI=""
