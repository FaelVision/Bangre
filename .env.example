DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-in-production-please-use-a-long-random-string"

# WhatsApp Cloud API (Meta). Leave unset to run in mock/dev mode — reminders
# and payment notifications are logged and recorded, not actually sent.
