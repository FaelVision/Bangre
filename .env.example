# Mobile Money providers. Leave unset to run in mock/dev mode (subscription
# payments auto-succeed as if the USSD prompt had been approved).
ORANGE_MONEY_API_KEY=""
ORANGE_MONEY_MERCHANT_ID=""
MOOV_MONEY_API_KEY=""
MOOV_MONEY_MERCHANT_ID=""
