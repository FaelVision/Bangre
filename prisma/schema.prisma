generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// A School is the single account/tenant. One login per établissement.
// ---------------------------------------------------------------------------
model School {
  id                    String    @id @default(cuid())
  name                  String
  city                  String?
  type                  String? // Primaire | Collège | Lycée | Franco-arabe...
  contactName           String
  phone                 String?   @unique
  email                 String?   @unique
  passwordHash          String
  createdAt             DateTime  @default(now())

  // Google sign-in: set once an account is linked to a Google identity.
  googleId              String?   @unique
  avatarUrl             String?

  subscriptionStatus    String    @default("trial") // trial | active | expired
  trialEndsAt           DateTime?
  subscriptionRenewsAt  DateTime?

  // Suspension by the platform administrator. A blocked school can still sign
  // in but only sees the suspension notice — its data is left untouched.
  blocked               Boolean   @default(false)
  blockedReason         String?
  blockedAt             DateTime?

  receiptCounter        Int       @default(0)

  academicYears         AcademicYear[]
  classes               SchoolClass[]
  students              Student[]
  payments              Payment[]
  reminders             Reminder[]
  subscriptionPayments  SubscriptionPayment[]
  syncLogEntries        SyncLogEntry[]
  adminMessages         AdminMessage[]
  errorLogs             ErrorLog[]
  passwordResetTokens   PasswordResetToken[]
}

/** A one-time link sent to a school to let them set a new password. */
model PasswordResetToken {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Only the hash is stored — the raw token lives in the link sent to the
  // school and is never persisted, so a database leak can't be replayed.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Platform side: the operator of Bangre, not a school.
// ---------------------------------------------------------------------------
model Admin {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  messages     AdminMessage[]
}

/** A message sent by the administrator to a school's account manager. */
model AdminMessage {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  channel   String   @default("whatsapp")
  toPhone   String
  body      String
  status    String   @default("sent") // sent | failed
  createdAt DateTime @default(now())
}

/**
 * Server-side errors captured by `onRequestError`, grouped by fingerprint so a
 * recurring crash shows as one entry with an occurrence count.
 */
model ErrorLog {
  id          String    @id @default(cuid())
  fingerprint String    @unique

  message     String
  stack       String?
  digest      String? // the code shown on Next's error screen
  route       String? // route file path, e.g. /(auth)/inscription
  path        String? // requested URL path
  method      String?
  source      String    @default("server") // server | client
  kind        String? // render | route | action | proxy

  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  label     String // "2026-2027"
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  classes   SchoolClass[]

  @@unique([schoolId, label])
}

model SchoolClass {
  id                      String   @id @default(cuid())
  schoolId                String
  school                  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId          String
  academicYear            AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name                    String // "6e A"
  level                   String // Primaire | Collège | Lycée
  order                   Int      @default(0) // CP1..Terminale ordering

  tuitionAmount           Int?
  registrationFee         Int?

  reminderEnabled         Boolean  @default(true)
  reminderBeforeDays      Int      @default(7)
  reminderAfterDays       String   @default("3,10") // csv of day offsets
  reminderHour            String   @default("08:00")
  reminderMessageTemplate String?

  archived                Boolean  @default(false)

  createdAt               DateTime @default(now())

  tranches                Tranche[]
  students                Student[]

  @@unique([schoolId, academicYearId, name])
}

model Tranche {
  id        String   @id @default(cuid())
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  label     String // "1re tranche"
  amount    Int
  // "tuition": a normal instalment whose amounts must sum to the class total.
  // "registration": the one-off enrolment fee, added on top of the tuition and
  // always ordered first (order 0) so a partial payment clears it before tranches.
  kind      String   @default("tuition")
  dueType   String // date | end_of_month | end_of_term
  dueDate   DateTime
  order     Int      @default(0)

  allocations PaymentAllocation[]
  reminders   Reminder[]
}

model Student {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String
  class          SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  matricule      String
  lastName       String
  firstName      String
  birthDate      DateTime?
  gender         String? // M | F

  parentName     String?
  parentPhone    String?
  whatsappStatus String   @default("unknown") // reachable | unreachable | invalid | unknown

  status         String   @default("active") // active | repeating | transferred | left
  tuitionOverride Int?

  createdAt      DateTime @default(now())

  payments       Payment[]
  reminders      Reminder[]
  promotionDecisions PromotionDecision[]

  @@unique([schoolId, matricule])
}

model Payment {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  amount         Int
  method         String   @default("cash") // cash | mobile_money | bank
  receivedBy     String?
  date           DateTime @default(now())
  receiptNumber  Int
  note           String?

  offlineCreated Boolean  @default(false)
  synced         Boolean  @default(true)

  whatsappNotified Boolean @default(false)

  allocations    PaymentAllocation[]

  @@unique([schoolId, receiptNumber])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  trancheId String
  tranche   Tranche @relation(fields: [trancheId], references: [id], onDelete: Cascade)
  amount    Int
}

model Reminder {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // The tranche this reminder was about, when it is a payment reminder. Used to
  // deduplicate the automatic scheduler: one "before" reminder per tranche, and
  // one "after" reminder per configured day-offset.
  trancheId  String?
  tranche    Tranche? @relation(fields: [trancheId], references: [id], onDelete: SetNull)

  channel    String   @default("whatsapp")
  trigger    String   @default("manual") // manual | auto_before | auto_after
  status     String   @default("sent") // sent | delivered | read | failed
  // Set from the WhatsApp provider's message id so delivery webhooks can match
  // a status update back to this row.
  providerMessageId String?
  message    String
  sentAt     DateTime @default(now())

  @@index([schoolId, sentAt])
  @@index([studentId, trancheId, trigger])
}

model SubscriptionPayment {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  amount    Int
  provider  String // orange_money | moov_money
  phone     String
  status    String   @default("pending") // pending | success | failed
  reference String?
  createdAt DateTime @default(now())
}

model PromotionDecision {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClassId String
  toClassId   String?
  decision    String // promote | repeat | transferred | left
  createdAt   DateTime @default(now())
}

model SyncLogEntry {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entity    String
  entityId  String
  action    String
  syncedAt  DateTime @default(now())
}
